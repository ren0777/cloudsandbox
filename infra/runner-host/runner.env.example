# Copy to runner.env on the runner server. Never commit the real file.
RUNNER_ID=runner-lab2
# 32+ random characters, different for every runner:  openssl rand -base64 36
RUNNER_SECRET=change-me
# how the API server reaches this runner (private network)
RUNNER_PUBLIC_URL=http://10.0.0.12:7070
PRIVATE_IP=10.0.0.12
# seats: size it from the load test (docs/LOADTEST.md); about 1.2 GiB RAM + 0.5 CPU per sandbox with headroom
RUNNER_MAX_SANDBOXES=8
CLOUDLABS_VERSION=dev
