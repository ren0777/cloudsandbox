# Control-plane secrets. Copy to production.env (outside git), chmod 600. Generate each value with:
#   openssl rand -base64 36
PUBLIC_HOST=labs.example.edu
CL_SECRET_KEY=change-me          # signs sessions AND encrypts runner secrets / terminal credentials (see DEPLOYMENT.md)
CL_RUNNER_SECRET=change-me       # the local runner's HMAC secret (other runners have their own)
POSTGRES_SUPERUSER_PASSWORD=change-me
CLOUDLABS_OWNER_PASSWORD=change-me
CLOUDLABS_APP_PASSWORD=change-me
CL_DEFAULT_EMULATOR=floci
RUNNER_MAX_SANDBOXES=8
TLS_DIR=/etc/cloudlabs/tls
ACME_DIR=/var/www/acme
