# Control-plane secrets. Copy to production.env (outside git), chmod 600.
# Generate each secret with:  openssl rand -hex 32
# The API (CL_DEMO_MODE=false) and the runner refuse to boot with known dev defaults, "change-me"
# or anything shorter than 32 characters, so every value below must be freshly generated.
PUBLIC_HOST=labs.example.edu
CL_SECRET_KEY=replace-with-$(openssl rand -hex 32)   # signs sessions AND encrypts runner secrets / terminal credentials (see DEPLOYMENT.md)
CL_RUNNER_SECRET=replace-with-$(openssl rand -hex 32)  # the local runner's HMAC secret (other runners have their own)
POSTGRES_SUPERUSER_PASSWORD=replace-with-$(openssl rand -hex 32)
CLOUDLABS_OWNER_PASSWORD=replace-with-$(openssl rand -hex 32)
CLOUDLABS_APP_PASSWORD=replace-with-$(openssl rand -hex 32)
CL_DEFAULT_EMULATOR=floci
RUNNER_MAX_SANDBOXES=8
TLS_DIR=/etc/cloudlabs/tls
ACME_DIR=/var/www/acme
